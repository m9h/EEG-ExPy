<<setup, echo=False>>=
import json, os
from datetime import datetime
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.signal import welch

# Silence matplotlib's interactive backend; we just save PNGs.
plt.switch_backend("Agg")

with open("params.json") as f:
    params = json.load(f)

csv_path = Path(params["csv_path"])
paradigm = params["paradigm"]
paradigm_label = params["paradigm_label"]
device = params["device"]

df = pd.read_csv(csv_path)
timestamps = df["timestamps"].to_numpy()
stim = df["stim"].to_numpy() if "stim" in df.columns else np.zeros(len(df))
eeg_cols = [c for c in df.columns if c not in ("timestamps", "stim")]
eeg = df[eeg_cols].to_numpy().T  # shape (n_channels, n_samples)
n_samples = eeg.shape[1]

# Robust sample rate estimate from timestamps (falls back to nominal
# per-device values if timestamps are bad).
dt = np.diff(timestamps)
sfreq = float(round(1.0 / np.median(dt))) if len(dt) else 250.0
duration_s = float(timestamps[-1] - timestamps[0]) if n_samples > 1 else 0.0

# Basic marker tally.
unique_markers, marker_counts = np.unique(stim[stim != 0], return_counts=True)
marker_tally = list(zip(unique_markers.tolist(), marker_counts.tolist()))
@

