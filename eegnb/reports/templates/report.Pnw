\section*{Signal quality}

<<channel-stats-table, echo=False, results='tex'>>=
print(r"\begin{tabular}{lrrr}")
print(r"\toprule")
print(r"Channel & Mean & SD & Range (min / max) \\")
print(r"\midrule")
for name, trace in zip(eeg_cols, eeg):
    mean = float(np.mean(trace))
    sd = float(np.std(trace))
    print(rf"{name} & {mean:.1f} & {sd:.1f} & {np.min(trace):.0f} / {np.max(trace):.0f} \\")
print(r"\bottomrule")
print(r"\end{tabular}")
@

<<psd-plot, echo=False, fig=True, width='\\linewidth', caption='Welch PSD per channel (0.5-40 Hz). Narrow-band peaks over noise floor indicate valid signal; broad elevation indicates line noise or movement artifact.'>>=
fig, ax = plt.subplots(figsize=(8, 4.5))
for name, trace in zip(eeg_cols, eeg):
    f, p = welch(trace - trace.mean(), fs=sfreq, nperseg=min(1024, n_samples))
    mask = (f >= 0.5) & (f <= 40)
    ax.semilogy(f[mask], p[mask], label=name, linewidth=0.8)
ax.set_xlabel("Frequency (Hz)")
ax.set_ylabel("PSD (a.u.)")
ax.set_title("Welch power spectral density")
ax.legend(ncol=4, fontsize=7, loc="upper right")
ax.grid(True, which="both", alpha=0.3)
fig.tight_layout()
@

<<paradigm-branch, echo=False>>=
# Pick the set of analysis frequencies and channels-of-interest for
# this paradigm. The template renders whichever block matches.

PARADIGM_PARAMS = {
    "stothart":  dict(label="Stothart Fastball (object recognition)",
                      base_hz=3.0,   oddball_hz=0.6,
                      roi=("Oz", "Pz"),
                      harmonics=(0.6, 1.2, 1.8, 2.4, 3.6, 4.2, 4.8)),
    "rossion":   dict(label="Rossion FPVS (face individuation)",
                      base_hz=5.88,  oddball_hz=1.176,
                      roi=("PO8", "Oz", "PO7"),
                      harmonics=(1.176, 2.352, 3.528, 4.704)),
    "ssvep":     dict(label="SSVEP",
                      base_hz=12.0,  oddball_hz=None,
                      roi=("Oz", "PO7", "PO8"),
                      harmonics=(12.0, 24.0)),
}

has_fpvs_block = paradigm in ("stothart", "rossion")
has_ssvep_block = paradigm == "ssvep"
@

<% if has_fpvs_block: %>

\clearpage
\section*{FPVS analysis (<%= PARADIGM_PARAMS[paradigm]['label'] %>)}

<<fpvs-setup, echo=False>>=
pp = PARADIGM_PARAMS[paradigm]
roi_channels = [c for c in pp["roi"] if c in eeg_cols]
missing = [c for c in pp["roi"] if c not in eeg_cols]

# FFT of the continuous EEG, per ROI channel.
# Use the full record length so the frequency resolution is 1/T.
fft_n = n_samples
freqs = np.fft.rfftfreq(fft_n, d=1.0 / sfreq)
amps = {name: np.abs(np.fft.rfft(eeg[eeg_cols.index(name)] - eeg[eeg_cols.index(name)].mean(), n=fft_n)) / fft_n
        for name in roi_channels}
@

<<fpvs-roi-info, echo=False, results='tex'>>=
print(r"\textbf{Region of interest}: "
      + ", ".join(rf"\texttt{{{c}}}" for c in roi_channels) + ".")
if missing:
    print(r"\\ \textit{Missing from device}: "
          + ", ".join(rf"\texttt{{{c}}}" for c in missing) + ".")
print(rf"\\ \textbf{{Base rate}}: \SI{{{pp['base_hz']}}}{{\hertz}}.")
print(rf"\\ \textbf{{Oddball frequency}}: \SI{{{pp['oddball_hz']}}}{{\hertz}} (and harmonics).")
@

<<fpvs-snr-table, echo=False, results='tex'>>=
def snr_at(amps_arr, freqs_arr, target, bw=0.10):
    """Liu-Shuang / Stothart SNR: amp at target / mean of +/- bw
    neighbouring bins, excluding the immediately-adjacent bin.
    """
    idx_target = np.argmin(np.abs(freqs_arr - target))
    mask_band = np.abs(freqs_arr - target) <= bw
    # Exclude the target bin and its two immediate neighbours.
    exclude = np.zeros_like(mask_band, dtype=bool)
    exclude[max(0, idx_target - 1): idx_target + 2] = True
    noise_mask = mask_band & ~exclude
    if not noise_mask.any():
        return float("nan")
    return float(amps_arr[idx_target] / np.mean(amps_arr[noise_mask]))

print(r"\begin{tabular}{lr" + "r" * len(pp["harmonics"]) + "}")
print(r"\toprule")
header = ["Channel", "Band rate"] + [rf"\SI{{{h:.3g}}}{{\hertz}}" for h in pp["harmonics"]]
print(" & ".join(header) + r" \\")
print(r"\midrule")
for name in roi_channels:
    base_snr = snr_at(amps[name], freqs, pp["base_hz"])
    harm_snrs = [snr_at(amps[name], freqs, h) for h in pp["harmonics"]]
    row = [name, f"{base_snr:.2f}"] + [f"{s:.2f}" for s in harm_snrs]
    print(" & ".join(row) + r" \\")
print(r"\bottomrule")
print(r"\end{tabular}")
@

<<fpvs-spectrum, echo=False, fig=True, width='\\linewidth', caption='Amplitude spectrum (0.2-8 Hz) for ROI channels. Red dashed line: base stimulation rate. Blue dashed lines: oddball fundamental and harmonics. A response at the oddball frequency that rises clearly above the neighbouring noise floor is the signature of category-level discrimination.'>>=
fig, ax = plt.subplots(figsize=(8, 4.5))
mask = (freqs >= 0.2) & (freqs <= 8.0)
for name in roi_channels:
    ax.plot(freqs[mask], amps[name][mask], label=name, linewidth=0.9)
ax.axvline(pp["base_hz"], color="red", linestyle="--", linewidth=1, label=f"base {pp['base_hz']} Hz")
for h in pp["harmonics"]:
    ax.axvline(h, color="blue", linestyle=":", alpha=0.5)
ax.set_xlabel("Frequency (Hz)")
ax.set_ylabel("|FFT| amplitude (a.u.)")
ax.set_title(f"{pp['label']}: amplitude spectrum at ROI channels")
ax.legend(loc="upper right", fontsize=8)
ax.grid(True, alpha=0.3)
fig.tight_layout()
@

