\section*{Interpretation and applications}

<<applications-text, echo=False, results='tex'>>=
BLURB = {
    "stothart": r"""\noindent This recording used the Stothart fastball paradigm
\cite{stothart2021brain}, a frequency-tagged oddball designed to passively probe
recognition memory. Standards and oddballs are everyday objects (base \SI{3}{\hertz},
oddball \SI{0.6}{\hertz}); a response at \SI{0.6}{\hertz} and its harmonics at
\texttt{Oz}/\texttt{Pz} indicates that the cortex has differentiated ``seen''
from ``unseen'' items, even when the participant gives no behavioural response.
Validated as a passive biomarker for mild cognitive impairment and Alzheimer's
disease; also used in home-use and remote testing.""",
    "rossion": r"""\noindent This recording used the Rossion FPVS face-individuation
paradigm \cite{liushuang2014}, in which one unfamiliar face identity is shown
repeatedly at \SI{5.88}{\hertz} with novel identities inserted every 5th
image (\SI{1.18}{\hertz}). A response at \SI{1.18}{\hertz} and harmonics over
right occipito-temporal cortex (here proxied by \texttt{PO8}) is the signature of
neural face individuation. The paradigm is used to index face-processing
deficits in acquired prosopagnosia and developmental conditions.""",
    "ssvep":   r"""\noindent This recording used an SSVEP paradigm: continuous
frequency-tagged stimulation elicits a phase-locked response at the stimulation
frequency and its harmonics. SSVEPs are the foundational frequency-tagging
technique \cite{norcia2015jvis}; face-specific FPVS and fastball build on the
same SNR argument.""",
}
print(BLURB.get(paradigm, ""))
@

