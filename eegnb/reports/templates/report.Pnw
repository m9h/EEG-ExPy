print(rf"Sample rate & {sfreq:.0f} Hz \\")
print(rf"Samples & {n_samples} \\")
print(rf"Duration & {duration_s:.2f} s \\")
print(rf"Non-zero markers & {int(np.sum(stim != 0))} \\")
print(r"\bottomrule")
print(r"\end{tabular}")
@

